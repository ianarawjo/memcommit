__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/

# Python build products are derived from the canonical package tree. Keeping
# them untracked prevents incremental wheel builds from reusing stale modules.
/build/
/dist/

.venv/
.env/
.pytest_cache/
.DS_Store

# Local artifact-tool scratch space and inspection sidecars are regenerated.
.codex-work/
*.inspect.ndjson

# Local command/PDF study rendering is reproducible scratch. Authored study
# evidence belongs under agent-records/docs/ or agent-records/outputs/; the
# temporary canvases and helper experiments below are not repository contracts.
/output/
/tmp/pdfs/build_*.py
/tmp/pdfs/*preflight.pdf
/tmp/pdfs/rendered/
