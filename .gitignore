# Keep the public repository limited to the distributable source and setup.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/uv.lock
!/src/

# Generated files and local configuration are never distribution inputs.
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.env
.env.*
.venv/

# Study projects are public placeholders; their contents stay private.
/src/memcommit/application/operations/init_study/study_scenarios/*
!/src/memcommit/application/operations/init_study/study_scenarios/isaac/
!/src/memcommit/application/operations/init_study/study_scenarios/peter/
!/src/memcommit/application/operations/init_study/study_scenarios/practice/
/src/memcommit/application/operations/init_study/study_scenarios/*/*
!/src/memcommit/application/operations/init_study/study_scenarios/*/.gitkeep
