# Python build products are derived from the canonical package tree. Keeping
# them untracked prevents incremental wheel builds from reusing stale modules.
/build/
/dist/

.venv/
.env/
.pytest_cache/
.DS_Store

# Local artifact-tool scratch space and inspection sidecars are regenerated.
.codex-work/
*.inspect.ndjson
