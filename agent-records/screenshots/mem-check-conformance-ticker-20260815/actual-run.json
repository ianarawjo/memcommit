    "rules": [
      {
        "uid": "0ecb2d81-5c8a-4ea7-ae33-eb38fbcc552e",
        "alias": "r1",
        "content": "When generating a synthetic ticker, first remove a leading article such as “The,” discard legal-form suffixes such as Inc., LLC, Ltd., PLC, Corp., or Corporation, and ignore connectors such as “&” when selecting ticker characters; preserve meaningful numeric tokens."
      },
      {
        "uid": "ecd5a4ab-4039-44c2-9411-8bb0c575e886",
        "alias": "r2",
        "content": "When the normalized company name has two or more meaningful words, form the base ticker from the initial character of each meaningful word, using the numeric character for a number-bearing word; preserve a meaningful abbreviation such as “AI” as a single ticker component."
      },
      {
        "uid": "feda9729-b43d-4565-98f3-8b90711477d2",
        "alias": "r3",
        "content": "When the normalized company name is a single word, derive a concise three-letter mnemonic from that word rather than applying the multiword-initial rule."
      },
      {
        "uid": "fa8f3b8c-f510-420b-9008-98c4b930f04e",
        "alias": "r4",
        "content": "When share-class details are present, keep the ordinary company base ticker and append a dot suffix: “.A” or “.B” for the corresponding class and “.P” for Preferred."
      },
      {
        "uid": "a9457f72-6155-4322-a692-91edaa142b61",
        "alias": "r5",
        "content": "Treat every generated symbol under these rules as a synthetic mnemonic; do not represent it as an official, unique, or exchange-valid market ticker without separate verification."
      }
    ],
