        "source_sha256": "e836ce3f40c2bffb7012fc3731e0db20b8492848bf2f2947304d61af31c2e70e",
        "translated_content": "\uae30\ub2a5\uc801 \uc81c\uc57d\uc758 \uc0ac\uc801\uc778 \uc6d0\uc778\uc740 \uc815\ubcf4 \uc694\uccad \uc5d0\uc774\uc804\ud2b8\uac00 \uc9c8\ubb38\ud558\ub294 \ub300\uc0c1\uc774 \uc544\ub2c8\uba70, \uc0ac\uc6a9\uc790\uac00 \uc815\ubd80 \uc758\ub8cc\uae30\uad00 \uc2dc\uc2a4\ud15c\uc758 \uc804\uc1a1 \ud654\uba74\uc5d0\uc11c \uc2e4\uc81c\ub85c \ubcf4\ub0b4\uba74 \uadf8 \ub0b4\uc6a9\ub3c4 \uacf5\uc720 \ub3d9\uc758 \ub2e8\uc704\uc5d0 \ud3ec\ud568\ub41c\ub2e4\uace0 \uc124\uba85\ud558\ub77c.",
