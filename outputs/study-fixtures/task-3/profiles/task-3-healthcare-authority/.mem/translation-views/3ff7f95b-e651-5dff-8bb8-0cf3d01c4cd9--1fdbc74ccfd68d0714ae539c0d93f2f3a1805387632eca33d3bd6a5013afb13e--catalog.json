      "curated": {
        "source_sha256": "c76535dede6e58430d235950ef4e8c7449d37bd78d729346e38523eb19486056",
        "translated_content": "\uae30\uad00\uc740 \uc801\uc6a9 \uc7a5\uc18c\u00b7\uc2dc\uac04\u00b7\ubc18\ubcf5\uc131\u00b7\uc77c\uc0c1 \uae30\ub2a5 \uc601\ud5a5\u00b7\uc54c\ub824\uc9c4 \uc608\uc678\ub97c \ud568\uaed8 \uac80\ud1a0\ud574 \uc77c\uc2dc\uc801 \uc0c1\ud0dc\uc640 \uc9c0\uc18d\uc801 \uc9c0\uc6d0 \ud544\uc694\ub97c \uad6c\ubd84\ud560 \uc218 \uc788\uc9c0\ub9cc, \uc815\ubcf4 \uc694\uccad \uc5d0\uc774\uc804\ud2b8\ub294 \uadf8 \uc804\ubb38\uc801 \ud310\ub2e8\uc744 \ub300\uc2e0\ud560 \uc218 \uc5c6\ub2e4\uace0 \uc124\uba85\ud558\ub77c.",
        "origin": "IMPORTED",
        "review_status": "UNREVIEWED",
