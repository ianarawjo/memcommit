        "translated_content": "\uc0ac\uc6a9\uc790\uac00 \uc88c\uc11d\u00b7\uc774\ub3d9 \uacbd\ub85c\u00b7\ub300\uae30 \ubc29\uc2dd\u00b7\uc758\uc0ac\uc18c\ud1b5 \uc911 \ub2ec\ub77c\uc838\uc57c \ud560 \uc0ac\ud56d\uc744 \uc815\ubd80 \uc758\ub8cc\uae30\uad00 \uc2dc\uc2a4\ud15c\uc758 \uc804\uc1a1 \ud654\uba74\uc5d0\uc11c \ubcf4\ub0b4\uba74 \uae30\uad00\uc758 \uc9c0\uc6d0 \uc900\ube44\uc5d0 \uc774\uc6a9\ub420 \uc218 \uc788\uc9c0\ub9cc, \uc815\ubcf4 \uc694\uccad \uc5d0\uc774\uc804\ud2b8\ub294 \uc2e4\uc81c \uc9c0\uc6d0 \ud544\uc694\ub97c \uacb0\uc815\ud560 \uc218 \uc5c6\ub2e4\uace0 \uc124\uba85\ud558\ub77c.",
        "origin": "IMPORTED",
        "review_status": "UNREVIEWED",
